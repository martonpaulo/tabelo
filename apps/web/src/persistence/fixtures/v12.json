{
	"version": 12,
	"name": "Formatted roster",
	"document": {
		"columns": [
			{
				"id": "c-name",
				"header": {
					"kind": "inline",
					"nodes": [{ "kind": "text", "text": "Name", "marks": ["bold"] }]
				},
				"align": "left",
				"expectedType": "text"
			},
			{
				"id": "c-city",
				"header": "City",
				"align": "default",
				"expectedType": "text"
			},
			{
				"id": "c-age",
				"header": "Age",
				"align": "right",
				"expectedType": "number"
			}
		],
		"rows": [
			{
				"id": "r-ingrid",
				"cells": {
					"c-name": "Ingrid",
					"c-city": {
						"kind": "inline",
						"nodes": [
							{ "kind": "text", "text": "Rio ", "marks": [] },
							{
								"kind": "image",
								"url": "https://example.com/rio.png",
								"alt": "Sugarloaf 🏔"
							},
							{
								"kind": "text",
								"text": "\nsouth",
								"marks": ["italic", "strikethrough"]
							}
						]
					},
					"c-age": 35
				}
			},
			{
				"id": "r-paulo",
				"cells": {
					"c-name": {
						"kind": "inline",
						"nodes": [
							{
								"kind": "link",
								"url": "mailto:paulo@example.com",
								"children": [
									{ "kind": "text", "text": "Paulo", "marks": ["underline"] },
									{ "kind": "text", "text": " mail", "marks": [] }
								]
							},
							{ "kind": "text", "text": " ", "marks": [] },
							{ "kind": "text", "text": "dev", "marks": ["code"] }
						]
					},
					"c-city": "Madrid",
					"c-age": null
				}
			}
		]
	},
	"workspace": {
		"layout": "columns",
		"panes": [
			{
				"id": "ac",
				"view": "grid",
				"slots": ["a", "c"],
				"zoom": 1,
				"wrap": null,
				"spaceIndicators": null,
				"tabIndicators": null,
				"emptyValueIndicators": null,
				"lineBreakIndicators": false,
				"alignColumns": false
			},
			{
				"id": "bd",
				"view": "markdown",
				"slots": ["b", "d"],
				"zoom": 1,
				"wrap": null,
				"spaceIndicators": null,
				"tabIndicators": null,
				"emptyValueIndicators": null,
				"lineBreakIndicators": null,
				"alignColumns": null
			}
		],
		"wrappedColumns": ["c-city"],
		"columnWidths": {},
		"columnRatio": 0.5,
		"rowRatio": 0.5,
		"activePaneId": "ac",
		"pinFirstDataRow": false,
		"pinFirstDataColumn": false
	},
	"draft": null
}
