{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!**/.next",
			"!**/dist",
			"!**/playwright-report",
			"!**/test-results",
			"!**/.turbo",
			"!**/.nx",
			"!**/dev-dist",
			"!**/.zed",
			"!**/.vscode",
			"!**/src-tauri",
			"!**/.nuxt",
			"!bts.jsonc",
			"!**/.expo",
			"!**/.wrangler",
			"!**/.alchemy",
			"!**/.svelte-kit",
			"!**/wrangler.jsonc",
			"!**/.source",
			"!**/convex/_generated",
			"!.claude"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				"useExhaustiveDependencies": "info"
			},
			"nursery": {
				"useTailwindSortedClasses": {
					"level": "warn",
					"fix": "safe"
				}
			},
			"style": {
				"noParameterAssign": "error",
				"useAsConstAssertion": "error",
				"useDefaultParameterLast": "error",
				"useEnumInitializers": "error",
				"useSelfClosingElements": "error",
				"useSingleVarDeclarator": "error",
				"noUnusedTemplateLiteral": "error",
				"useNumberNamespace": "error",
				"noInferrableTypes": "error",
				"noUselessElse": "error"
			}
		}
	},
	"overrides": [
		// Playwright's `locator.innerText()` reads the rendered text on purpose;
		// the rule added in Biome 2.6 mistakes it for the DOM property.
		{
			"includes": ["apps/web/e2e/**"],
			"linter": {
				"rules": {
					"performance": {
						"useDomNodeTextContent": "off"
					}
				}
			}
		},
		{
			"includes": ["apps/web/src/core/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["react", "react/**", "react-dom", "react-dom/**"],
										"message": "The table document core is framework-free: it owns plain data and pure operations, so it cannot import React or any UI package. Move the presentation into a component under apps/web/src/ui."
									},
									{
										"group": ["@/ui", "@/ui/**", "@tabelo/ui", "@tabelo/ui/**"],
										"message": "The table document core is framework-free: it owns plain data and pure operations, so it cannot import React or any UI package. Move the presentation into a component under apps/web/src/ui."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["apps/web/src/formats/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["react", "react/**", "react-dom", "react-dom/**"],
										"message": "Codecs own format syntax, never presentation: a parse/serialize pair cannot import React or any UI package. Move the rendering into the view that displays the format."
									},
									{
										"group": ["@/ui", "@/ui/**", "@tabelo/ui", "@tabelo/ui/**"],
										"message": "Codecs own format syntax, never presentation: a parse/serialize pair cannot import React or any UI package. Move the rendering into the view that displays the format."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["apps/web/src/views/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@codemirror/**", "codemirror"],
										"message": "The view registry declares what the workspace can display, by capability: it cannot import CodeMirror or a UI component. Load the editor from the pane that renders the view."
									},
									{
										"group": ["@/ui", "@/ui/**", "@tabelo/ui", "@tabelo/ui/**"],
										"message": "The view registry declares what the workspace can display, by capability: it cannot import CodeMirror or a UI component. Load the editor from the pane that renders the view."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			// All of packages/ui, the vendored primitives and Tabelo's own
			// components alike: the import boundary has nothing to do with the
			// a11y exemption below, so it carries no exclusion of its own (#437).
			"includes": ["packages/ui/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@/**"],
										"message": "Shared UI does not know the product: packages/ui cannot import application code from apps/web. Pass what the component needs in through its props."
									},
									{
										"group": ["apps/**", "**/apps/web/**"],
										"message": "Shared UI does not know the product: packages/ui cannot import application code from apps/web. Pass what the component needs in through its props."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			// The vendored shadcn primitives only, and only the a11y exemption.
			// Tabelo's own components in this folder are excluded by name: the
			// a11y rules below are load-bearing for them, and the exemption exists
			// because a vendored primitive receives its wiring from the consumer.
			// An allow-list of the vendored shadcn files by name, so a component
			// Tabelo writes in this folder keeps the rules by default (#573).
			"includes": [
				"packages/ui/src/components/badge.tsx",
				"packages/ui/src/components/button.tsx",
				"packages/ui/src/components/card.tsx",
				"packages/ui/src/components/checkbox.tsx",
				"packages/ui/src/components/context-menu.tsx",
				"packages/ui/src/components/dialog.tsx",
				"packages/ui/src/components/dropdown-menu.tsx",
				"packages/ui/src/components/empty.tsx",
				"packages/ui/src/components/input-group.tsx",
				"packages/ui/src/components/input.tsx",
				"packages/ui/src/components/label.tsx",
				"packages/ui/src/components/radio-group.tsx",
				"packages/ui/src/components/separator.tsx",
				"packages/ui/src/components/skeleton.tsx",
				"packages/ui/src/components/sonner.tsx",
				"packages/ui/src/components/switch.tsx",
				"packages/ui/src/components/textarea.tsx",
				"packages/ui/src/components/toggle-group.tsx",
				"packages/ui/src/components/toggle.tsx",
				"packages/ui/src/components/tooltip.tsx"
			],
			"linter": {
				"rules": {
					"a11y": {
						"noLabelWithoutControl": "off",
						"useSemanticElements": "off",
						"useKeyWithClickEvents": "off"
					}
				}
			}
		}
	],
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	// Biome 2.6 began formatting Markdown, and its formatter puts a blank line
	// inside a skill's YAML frontmatter. Prose stays as written.
	"markdown": {
		"formatter": {
			"enabled": false
		}
	},
	"tailwind": { "mergeFunctions": ["clsx", "cn"], "variantFunctions": ["cva"] }
}
